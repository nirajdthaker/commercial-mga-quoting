rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One doc per uploaded submission. Extraction status/results are written
    // by the extractSubmission Cloud Function via the Admin SDK, which
    // bypasses these rules entirely — the rules below only constrain what
    // signed-in team members can do directly from the app.
    match /submissions/{submissionId} {
      // Shared review queue: any signed-in team member can see all
      // submissions, not just their own upload.
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.status == 'uploaded'
                    && request.resource.data.keys().hasOnly(
                         ['industryId', 'fileName', 'filePath', 'uploadedBy', 'uploadedAt', 'status']
                       );

      // Team members may only correct extracted fields and mark a
      // submission reviewed, once extraction has produced a result.
      allow update: if request.auth != null
                    && resource.data.status == 'extracted'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ['extractedProfile', 'extractedLocations', 'status', 'reviewedBy', 'reviewedAt']
                       )
                    && request.resource.data.status in ['extracted', 'reviewed']
                    && (request.resource.data.status != 'reviewed'
                        || request.resource.data.reviewedBy == request.auth.uid);

      allow delete: if false;
    }
  }
}
