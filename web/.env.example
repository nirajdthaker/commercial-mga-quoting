# Copy this file to .env.local and fill in the values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
#
# .env.local is gitignored — never commit real Firebase web config to git history
# even though these values are not treated as secret by Firebase, since Storage/Auth
# access is enforced separately by security rules, not by hiding this config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=commercial-mga-quoting.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=commercial-mga-quoting
VITE_FIREBASE_STORAGE_BUCKET=commercial-mga-quoting.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
